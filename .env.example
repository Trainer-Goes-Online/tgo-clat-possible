# ============================================================
# CLAT Possible · FREE funnel — environment variables.
# Copy to .env.local for local dev; set the SAME keys in each Vercel project.
# Per-deploy values (pixel/token/webhook/site URL) differ between free.* and
# free2.*; everything else is identical on both.
# ============================================================

# ---- Pabbly Connect webhook (one per free funnel) ----
PABBLY_WEBHOOK_URL=https://connect.pabbly.com/webhook-listener/webhook/xxxxxxxx

# ---- Meta Pixel + Conversions API (DIFFERS per deploy: pixel A vs pixel B) ----
# Pixel/Dataset ID — same value client + server (not a secret).
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
META_PIXEL_ID=000000000000000
# CAPI access token — server-only secret. NEVER prefix with NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# Graph API version (optional; defaults to v25.0 in code).
META_GRAPH_API_VERSION=v25.0
# Test Events code — set a REAL one while validating; LEAVE BLANK in production.
META_TEST_EVENT_CODE=

# ---- Free funnel events (used by /api/free-register) ----
FREE_STANDARD_EVENT=CompleteRegistration
FREE_CUSTOM_EVENT=FreeWebinarRegistration

# ---- Site origin (per deploy: free.* or free2.*; no trailing slash) ----
NEXT_PUBLIC_SITE_URL=https://free.webinar.clatpossible.com

# ---- Webinar schedule + WhatsApp link (same on both free deploys) ----
NEXT_PUBLIC_WEBINAR_DATES_LONG=28, 29 & 30 June 2026
NEXT_PUBLIC_WEBINAR_DATES_SHORT=28, 29 & 30 June
NEXT_PUBLIC_WEBINAR_TIME=11:00 AM IST
NEXT_PUBLIC_WEBINAR_TIME_SHORT=11 AM IST
NEXT_PUBLIC_WEBINAR_DURATION=2 hrs/day
NEXT_PUBLIC_WEBINAR_DURATION_LONG=2 hours each day
NEXT_PUBLIC_WEBINAR_DAY1=28 June
NEXT_PUBLIC_WEBINAR_DAY2=29 June
NEXT_PUBLIC_WEBINAR_DAY3=30 June
NEXT_PUBLIC_WEBINAR_DAY1_SHORT=28 Jun
NEXT_PUBLIC_WEBINAR_DAY2_SHORT=29 Jun
NEXT_PUBLIC_WEBINAR_DAY3_SHORT=30 Jun
NEXT_PUBLIC_WEBINAR_DEADLINE_ISO=2026-06-28T11:00:00+05:30
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/xxxxxxxx
