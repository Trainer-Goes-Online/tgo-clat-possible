# ============================================================
# CLAT Possible · Razorpay credentials — copy to .env.local and fill in.
# ============================================================
# Public Key ID (safe to expose; Razorpay's checkout modal needs it client-side).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Secret — NEVER expose. Used server-side to create orders + verify the HMAC signature.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Seat price in paise. ₹49 = 4900. Single source of truth (server owns the amount).
RAZORPAY_AMOUNT_PAISE=4900
RAZORPAY_CURRENCY=INR

# ============================================================
# Pabbly Connect webhook — receives the enriched lead row per purchase.
# ============================================================
PABBLY_WEBHOOK_URL=https://connect.pabbly.com/webhook-listener/webhook/xxxxxxxx

# ============================================================
# Meta Pixel + Conversions API (CAPI)
# ============================================================
# Pixel / Dataset ID — same value client + server (pixel IDs are not secrets).
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
META_PIXEL_ID=000000000000000

# CAPI access token — server-only secret. NEVER prefix with NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Graph API version (optional; defaults to v25.0).
META_GRAPH_API_VERSION=v25.0

# Events Manager Test Events code (blank in production).
META_TEST_EVENT_CODE=

# Production site origin (no trailing slash) — event_source_url fallback.
NEXT_PUBLIC_SITE_URL=https://example.com

# ============================================================
# Webinar schedule + WhatsApp link (NEXT_PUBLIC_; shown across the whole funnel).
# ============================================================
NEXT_PUBLIC_WEBINAR_DATES_LONG=28, 29 & 30 June 2026
NEXT_PUBLIC_WEBINAR_DATES_SHORT=28, 29 & 30 June
NEXT_PUBLIC_WEBINAR_TIME=11:00 AM IST
NEXT_PUBLIC_WEBINAR_TIME_SHORT=11 AM IST
NEXT_PUBLIC_WEBINAR_DURATION=2 hrs/day
NEXT_PUBLIC_WEBINAR_DURATION_LONG=2 hours each day
NEXT_PUBLIC_WEBINAR_DAY1=28 June
NEXT_PUBLIC_WEBINAR_DAY2=29 June
NEXT_PUBLIC_WEBINAR_DAY3=30 June
NEXT_PUBLIC_WEBINAR_DAY1_SHORT=28 Jun
NEXT_PUBLIC_WEBINAR_DAY2_SHORT=29 Jun
NEXT_PUBLIC_WEBINAR_DAY3_SHORT=30 Jun
NEXT_PUBLIC_WEBINAR_DEADLINE_ISO=2026-06-28T11:00:00+05:30
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/xxxxxxxx
